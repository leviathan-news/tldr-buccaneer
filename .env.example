# ================================================
# TL;DR Buccaneer Configuration
# ================================================
# Copy this file to .env and fill in your values
#
# Two modes available:
# 1. Single-bot mode: One wallet (MNEMONIC or WALLET_PRIVATE_KEY)
# 2. Fleet mode: HD wallet derivation from MNEMONIC with multiple personas

# ================================================
# HD WALLET (RECOMMENDED - Fleet Mode)
# ================================================
# Your BIP-39 mnemonic (12 or 24 words) for HD wallet derivation
# This single seed phrase derives wallets for ALL personas automatically!
#
# IMPORTANT: Keep this SECRET! Never commit this file to git!
# Generate a new mnemonic at: https://iancoleman.io/bip39/
#
MNEMONIC="abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about"

# ================================================
# Deepseek API (REQUIRED)
# ================================================
# Get your API key from: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Optional: Change the model (default: deepseek-chat)
# DEEPSEEK_MODEL=deepseek-chat

# Optional: Custom API base URL (default: https://api.deepseek.com)
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ================================================
# MODE SELECTION
# ================================================
# Set to "true" for multi-persona A/B/C testing (requires MNEMONIC)
# Set to "false" (or omit) for single-bot mode
FLEET_MODE=true

# ================================================
# SINGLE-BOT MODE (if FLEET_MODE=false)
# ================================================
# Option 1: Use MNEMONIC (recommended) - wallet derived at index 0
# Option 2: Use explicit private key (legacy)
#
# Your wallet's private key (KEEP THIS SECRET!)
# WALLET_PRIVATE_KEY=your_private_key_here
#
# Enable pirate-themed summaries (default: true)
# PIRATE_MODE=true

# ================================================
# DICE ROLL CONFIGURATION (Fleet Mode)
# ================================================
# Probability weights for 0, 1, 2, 3 TL;DRs per article
# Format: four comma-separated decimals that sum to 1.0
# Default: 0.25,0.40,0.25,0.10 (weighted toward 1 TL;DR)
#
# Examples:
#   0.25,0.40,0.25,0.10 - Weighted toward 1 (40% chance of 1 TL;DR)
#   0.25,0.25,0.25,0.25 - Equal distribution
#   0.10,0.50,0.30,0.10 - Heavily weighted toward 1-2 TL;DRs
#   0.40,0.30,0.20,0.10 - More likely to skip articles
#
# DICE_WEIGHTS=0.25,0.40,0.25,0.10

# ================================================
# PERSONA CONFIGURATION
# ================================================
# Personas are now defined in src/personas_config.py (no secrets!)
# Each persona gets a wallet derived from MNEMONIC at their assigned index:
#
#   pirate   -> m/44'/60'/0'/0/0  (index 0)
#   straight -> m/44'/60'/0'/0/1  (index 1)
#   ornery   -> m/44'/60'/0'/0/2  (index 2)
#   hype     -> m/44'/60'/0'/0/3  (index 3)
#
# To add more personas, just edit src/personas_config.py and assign a new index!

# ================================================
# Leviathan API (OPTIONAL)
# ================================================
# API base URL (default: https://api.leviathannews.xyz/api/v1)
# NOTE: The API is at api.leviathannews.xyz, NOT leviathannews.xyz (that's the frontend)
# API_BASE_URL=https://api.leviathannews.xyz/api/v1

# UTM source tag for tracking (default: tldr-buccaneer)
# UTM_SOURCE=tldr-buccaneer

# ================================================
# Bot Settings (OPTIONAL)
# ================================================
# How often to check for new articles, in minutes (default: 5)
# POLL_INTERVAL_MINUTES=5

# Maximum articles to process per polling cycle (default: 10)
# MAX_ARTICLES_PER_RUN=10
